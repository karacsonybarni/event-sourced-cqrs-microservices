# The service Dockerfiles need only their packaged application JARs.
**

!.dockerignore
!api-gateway/
api-gateway/**
!api-gateway/Dockerfile
!api-gateway/target/
api-gateway/target/**
!api-gateway/target/api-gateway-*.jar
!discovery-server/
discovery-server/**
!discovery-server/Dockerfile
!discovery-server/target/
discovery-server/target/**
!discovery-server/target/discovery-server-*.jar
!order-command-service/
order-command-service/**
!order-command-service/Dockerfile
!order-command-service/target/
order-command-service/target/**
!order-command-service/target/order-command-service-*.jar
!inventory-service/
inventory-service/**
!inventory-service/Dockerfile
!inventory-service/target/
inventory-service/target/**
!inventory-service/target/inventory-service-*.jar
!order-projection-worker/
order-projection-worker/**
!order-projection-worker/Dockerfile
!order-projection-worker/target/
order-projection-worker/target/**
!order-projection-worker/target/order-projection-worker-*.jar
!order-query-service/
order-query-service/**
!order-query-service/Dockerfile
!order-query-service/target/
order-query-service/target/**
!order-query-service/target/order-query-service-*.jar
